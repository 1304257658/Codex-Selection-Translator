# Copy this file to .env and uncomment only the settings you need.
# Command-line arguments and process environment variables override this file.

# Proxy used by Codex and the translation backend. Change the port for your proxy app.
# CODEX_TRANSLATOR_PROXY_URL=http://127.0.0.1:10808

# Optional PEM certificate bundle for a proxy or TLS inspection setup.
# Relative paths are resolved from the installed/project directory.
# CODEX_TRANSLATOR_CA_BUNDLE=codex-ca-bundle.pem

# Optional Codex executable override. Usually auto-detected after Codex updates.
# CODEX_DESKTOP_EXE=C:\Program Files\WindowsApps\OpenAI.Codex_<version>_x64__2p2nqsd0c76g0\app\ChatGPT.exe

# Local Chrome DevTools Protocol port used by the injector.
# CODEX_TRANSLATOR_CDP_PORT=9222
